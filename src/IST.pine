capN       = input.int(300, "Capture last N closed bars", minval = 50, maxval = 2000, group = G_DBG, display = display.none)

// ════ CONSTANTS ════════════════════════════════════════════════════════════════

CLR_NONE   = color.new(color.black, 100)
TF_MS      = timeframe.in_seconds() * 1000
EPS        = syminfo.mintick * 0.01    // float tolerance for tick comparisons
HALF_TICK  = syminfo.mintick * 0.5
T_HIST     = 45                        // transparency: superseded (historical) level
T_FADED    = 93                        // transparency: faded FVG fill
EV_LOG_MAX = 40
OBJ_WARN   = 450                       // warn before TradingView's 500-object limit
K_PDH      = 0
K_PDL      = 1
K_PWH      = 2
K_PWL      = 3
K_DO       = 4
K_MO       = 5
EV_FVG_CREATED = 1
EV_FVG_TOUCH   = 2
EV_FVG_CE      = 3
EV_FVG_FULL    = 4
EV_FVG_INVAL   = 5
EV_FVG_DROPPED = 6
EV_SES_START   = 7
EV_SES_END     = 8
EV_LEVEL_SET   = 9
EV_LIQ_CREATED = 10                    // liquidity: dir +1 = BSL/EQH, −1 = SSL/EQL
EV_LIQ_TAKEN   = 11
EV_LIQ_SWEEP   = 12
EV_LIQ_BREAK   = 13
EV_LIQ_DROPPED = 14
EV_EQ_CREATED  = 15
EV_EQ_TAKEN    = 16
EV_EQ_DROPPED  = 17
CLS_NONE       = 0                     // take classification (DEF-L4)
CLS_SWEEP      = 1
CLS_BREAK      = 2
LIQ_TRA_LEN    = 14                    // liquidity's own TR-average length: FVG inputs never affect it
EQ_MEM         = 25                    // EQ clusters kept per side
T_TAKEN        = 55                    // transparency: taken liquidity level

f_lineStyle(LnStyle s) =>
    switch s
        LnStyle.dashed => line.style_dashed
        LnStyle.dotted => line.style_dotted
        => line.style_solid

LBL_SIZE = switch lblSizeIn
    LblSize.tiny   => size.tiny
    LblSize.normal => size.normal
    => size.small

bool   showCE     = fvgShowCE and not minimalMode
bool   showFvgTxt = (fvgLabels and not minimalMode) or dbgOn
bool   keepFaded  = fvgMitView == MitView.fade and not minimalMode
bool   showSesBox = sesBox and not minimalMode
bool   showSesMid = sesMid and not minimalMode
string PD_STYLE   = f_lineStyle(pdSty)
string PW_STYLE   = f_lineStyle(pwSty)
bool   showLiqTxt = liqLabels and not minimalMode

// DEF-L3: every sensitivity preset is exactly four numbers (left, right, k, W). W is
// the DEF-L2 dominance window (C1, v0.4.4-dev); Custom has no W input: W = 0, off.
int LIQ_L = switch liqPreset
    LiqPreset.aggressive => 3
    LiqPreset.balanced   => 5
    LiqPreset.strict     => 10
    => liqLeftIn
int LIQ_R = switch liqPreset
    LiqPreset.aggressive => 2
    LiqPreset.balanced   => 3
    LiqPreset.strict     => 5
    => liqRightIn
float LIQ_K = switch liqPreset
    LiqPreset.aggressive => 0.5
    LiqPreset.balanced   => 1.0
    LiqPreset.strict     => 2.0
    => liqReactIn
int LIQ_W = switch liqPreset
    LiqPreset.aggressive => 10
    LiqPreset.balanced   => 30
    LiqPreset.strict     => 60
    => 0
float EQ_TOL = eqTolTk * syminfo.mintick

// ════ TYPES ════════════════════════════════════════════════════════════════════

// L5 · one auditable state transition.
type Event
    int    kind         // EV_*
    int    dir          // FVG: +1 bull / −1 bear · levels: +1 high / −1 low · 0 n/a
    int    sid          // structure id: FVG/session = its time id, level = K_*
    int    originBar    // where the structure originated
    int    eventBar     // bar on which the transition happened
    int    eventTime
    float  price
    string reason       // short rule code for audit

// L3 · horizontal reference level (period levels and session high/low).
type RefLevel
    int    kind         // K_* for period levels, −1 for session high/low
    string tag
    bool   isHigh
    bool   developing   // value can still change (session in progress)
    float  price
    int    anchorTime   // occurred: bar that printed it (na when not verifiable)
    int    knownTime    // confirmed: first bar the final value was known
    int    endTime      // na while live; set when the next instance supersedes it
    line   ln           // L6 handles, na when not drawn
    label  lbl

// L3 · one instance of a session window.
type SessionRange
    int      id         // start time: stable across reloads
    int      slot
    string   name
    bool     complete
    int      startBar
    int      startTime
    int      endBar     // last bar inside the window; na while developing
    int      endTime
    RefLevel hi
    RefLevel lo
    box      area       // L6 handles
    line     mid

// L3 · one fair value gap. Milestones are independent: each is stamped once with
// bar and time, whatever the display policy is (DEF-A4). Bars and times are kept
// so any past moment inside the memory window can be reconstructed (ARCH §3.4).
type Fvg
    int    id           // = confirmTime: stable across reloads
    bool   isBull
    string tf
    int    originBar    // candle 1
    int    originTime
    int    confirmBar   // candle 3: the record is created at its close
    int    confirmTime
    float  top
    float  bottom
    float  mid
    float  sizeTra      // gap / reference TR average (kept for the Phase 5 score)
    float  thrTick      // thresholds in force at birth (audit; DEF-A2)
    float  thrTra
    float  thrRng
    float  extreme      // deepest penetration so far
    int    touchBar
    int    touchTime
    int    ceBar
    int    ceTime
    int    fullBar
    int    fullTime
    int    invBar
    int    invTime
    box    zone         // L6 handles, na when not drawn
    line   ce

// L3 · equal highs / equal lows: one pool of significant same-side swings within
// tolerance (DEF-L5). Identity and boundary are separate fields: `id` and `ref` never
// change; `bound` is the pool's current outer edge (EQH: highest accepted member)
// and is what joins, takes, events and drawings use. A join can only widen `bound`
// (max for EQH, min for EQL). With the DEF-L1 pivot it never does in practice: a
// swing beyond `bound` must print after the last member confirmed, so it takes the
// cluster first (proof: LIQUIDITY.md DEF-L5.4).
type EqCluster
    int        id           // creation time (close of the bar where the 2nd member confirmed)
    bool       isHigh
    float      ref          // creation reference = extreme of the first two members; never changes
    float      bound        // current outer boundary; starts at ref, monotone outward
    array<int> members      // member level ids (swing times), in join order
    int        originBar    // earliest member's swing bar
    int        originTime
    int        lastBar      // latest member's confirmation
    int        lastTime
    int        qualBar      // member count reached the minimum: EQH/EQL_CREATED; na before
    int        qualTime
    int        takenBar     // first bar trading beyond `bound`; na = active
    int        takenTime
    int        cls = 0      // CLS_* decided at the taking bar's close

// L3 · one liquidity level = one confirmed, significant swing (DEF-L1…L4). The
// factual take and its classification are separate fields (DEF-L4). No drawing
// handles: the renderer rebuilds its view from these fields (DEF-L7).
type Liq
    int       id            // = originTime (swing bar): stable across reloads
    bool      isBsl         // swing high → BSL · swing low → SSL
    float     price
    int       originBar     // swing bar X
    int       originTime
    int       confirmBar    // X + right: the level exists from this bar's close
    int       confirmTime
    int       pivL          // pivot window in force at birth
    int       pivR
    float     react         // reaction inside the confirmation window (points)
    float     reactReq      // required reaction at birth (points) = k × tra
    float     tra           // TR average at the swing bar
    int       touches = 0   // bars reaching the price exactly, without trading through, before the take
    int       takenBar      // first bar trading beyond the price; na = active
    int       takenTime
    float     takeExt       // that bar's high (BSL) / low (SSL)
    float     takeClose
    bool      takeGap = false   // that bar opened beyond the price
    int       cls = 0       // CLS_NONE until the taking bar closes, then CLS_SWEEP or CLS_BREAK
    float     far           // furthest price traded beyond the level since the take
    bool      eqOpen = true // can still form or join an EQ cluster (never beyond price ± tolerance)
    EqCluster eq            // cluster membership; na if none

// L3 · one side of the liquidity engine (BSL or SSL): records and counters in one
// object, so a single set of methods serves both sides.
type LiqSide
    bool             isBsl
    array<Liq>       live         // can still change: active, or taken but still EQ-eligible
    array<Liq>       hist         // closed: taken and no longer EQ-eligible, in closing order
    array<EqCluster> eqs          // active and taken clusters, oldest first
    float            trig         // nearest price at which a live record changes; na = none live
    int              pivots = 0   // confirmed pivots, significant or not
    int              rejects = 0  // pivots judged and failing significance (warm-up pivots are neither)
    int              rejReact = 0 // … by reason, disjoint: reaction only, dominance only, both
    int              rejDom = 0
    int              rejBoth = 0
    int              levels = 0   // pivots that passed the significance filter (each one creates a level)
    int              dropLive = 0
    int              dropHist = 0
    int              dropEq = 0

// ════ STATE ════════════════════════════════════════════════════════════════════

// L3 · logical state
var array<RefLevel>     liveLvl     = array.new<RefLevel>(6)    // indexed by K_*
var array<SessionRange> liveSes     = array.new<SessionRange>(4)
var array<Fvg>          bullFvgs    = array.new<Fvg>()          // open + closed records, oldest first
var array<Fvg>          bearFvgs    = array.new<Fvg>()
var int                 dropOpen    = 0
var int                 dropClosed  = 0
// L5 · events of this execution + capped audit log
var array<Event>        barEv       = array.new<Event>()
var array<Event>        evLog       = array.new<Event>()
// L3 → L6 hand-off, cleared every execution
var array<Fvg>          fvgDropNow  = array.new<Fvg>()
var array<RefLevel>     lvlNewNow   = array.new<RefLevel>()
var array<RefLevel>     lvlEndNow   = array.new<RefLevel>()
var array<SessionRange> sesDirtyNow = array.new<SessionRange>()
var array<SessionRange> sesEndNow   = array.new<SessionRange>()
// L6 · visual history only (dropping these never touches logical state)
var array<RefLevel>     histLvl     = array.new<RefLevel>()
var array<SessionRange> histSes     = array.new<SessionRange>()
var array<Fvg>          fadedFvg    = array.new<Fvg>()
var array<line>         liqLns      = array.new<line>()         // liquidity view, rebuilt on the last bar
var array<label>        liqLbls     = array.new<label>()
var array<int>          liqCnt      = array.new<int>(7, 0)      // drawn: BSL, SSL, EQH, EQL, taken B, taken S, merged
// L3 · liquidity (DEF-L1…L6)
var LiqSide bslS = LiqSide.new(isBsl = true, live = array.new<Liq>(), hist = array.new<Liq>(), eqs = array.new<EqCluster>())
var LiqSide sslS = LiqSide.new(isBsl = false, live = array.new<Liq>(), hist = array.new<Liq>(), eqs = array.new<EqCluster>())
// L1 · chart-side period trackers: anchors + source validation (DEF-G6)
var float dHi     = na
var int   dHiT    = na
var float dLo     = na
var int   dLoT    = na
var bool  dFull   = false
var int   dStartT = na
var float wHi     = na
var int   wHiT    = na
var float wLo     = na
var int   wLoT    = na
var bool  wFull   = false
var int   wStartT = na
var int   pdN     = 0
var int   pdBad   = 0
var int   pdBadT  = na
var int   pwN     = 0
var int   pwBad   = 0
var int   pwBadT  = na

// ════ L1 · MARKET DATA / TIME ENGINE (every bar, unconditionally) ═══════════════

// DEF-A2: deterministic TR average (SMA of true range), NOT Wilder ATR (ta.atr, RMA). An RMA depends on every
// bar since the first loaded one, so its value at a fixed bar drifts as the
// history window moves; a finite window gives the same value after any reload.
float traNow  = ta.sma(ta.tr(true), fvgLen)
float rngNow  = ta.sma(high - low, fvgLen)
float refTra  = traNow[2]         // value at the close of t-2 (candle 1)
float refRng  = rngNow[2]
int   c1Time  = time[2]
float c1High  = high[2]
float c1Low   = low[2]
int   prevT   = time[1]

// Liquidity references (DEF-L1, DEF-L2). Own fixed-length TR average, so changing an
// FVG input never changes liquidity. Window extremes are series over the last n bars.
float liqTra  = ta.sma(ta.tr(true), LIQ_TRA_LEN)
float hiL     = ta.highest(high, LIQ_L)
float loL     = ta.lowest(low, LIQ_L)
float hiR     = ta.highest(high, LIQ_R)
float loR     = ta.lowest(low, LIQ_R)
int   swBar   = bar_index - LIQ_R    // candidate swing bar X, judged when bar X + right closes
int   swTime  = time[LIQ_R]

// The single gate between "observe" and "change state" (ARCHITECTURE §5).
bool engineTick = not confirmedOnly or barstate.isconfirmed

bool   intraday   = timeframe.isintraday
bool   sesTfOk    = intraday and timeframe.in_seconds() <= 3600   // windows are meaningless above 1H
string D_TF       = intraday ? "1D" : timeframe.period
string W_TF       = intraday or timeframe.isdaily ? "1W" : timeframe.period
bool   newDay     = timeframe.change(D_TF)
bool   newWeek    = timeframe.change(W_TF)
bool   atMidnight = hour(time, sesTz) == 0 and dayofmonth(time, sesTz) != dayofmonth(nz(time[1], time), sesTz)

// DEF-G2: previous *completed* HTF bar. The [1] sits inside the requested
// expression; lookahead_on only aligns that already-closed value to the start of
// the current HTF bar. Without [1] this would leak the future.
[pdH, pdL] = request.security(syminfo.tickerid, D_TF, [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwH, pwL] = request.security(syminfo.tickerid, W_TF, [high[1], low[1]], lookahead = barmerge.lookahead_on)

// DEF-F1: membership by bar open time, all weekdays (futures open Sunday evening).
bool inS1 = not na(time(timeframe.period, s1Ss + ":1234567", sesTz)) and sesTfOk
bool inS2 = not na(time(timeframe.period, s2Ss + ":1234567", sesTz)) and sesTfOk
bool inS3 = not na(time(timeframe.period, s3Ss + ":1234567", sesTz)) and sesTfOk
bool inS4 = not na(time(timeframe.period, s4Ss + ":1234567", sesTz)) and sesTfOk

// ════ L2 · DETECTION + L4 · FILTERING (pure, no state) ══════════════════════════

// DEF-A1: raw 3-candle structure, evaluated on candle 3.
bool  rawBull = low > c1High
bool  rawBear = high < c1Low
float rawGap  = rawBull ? low - c1High : rawBear ? c1Low - high : na   // points; same semantics both sides

// DEF-A2: qualification ([calc]). ONE required size, shared by both directions:
//   requiredGap = max(tick threshold, TR-average threshold, avg-range threshold)
// A disabled threshold is 0; a reference still warming up is na and rejects.
// Every reference is final at t-2. L4 extension point: future optional filters
// (e.g. middle-candle direction) go here as separate [calc] terms, OFF by default.
float tickReq  = fvgMinTicks * syminfo.mintick
float traReq   = fvgMinTra > 0 ? fvgMinTra * refTra : 0.0
float rngReq   = fvgMinRng > 0 ? fvgMinRng * refRng : 0.0
float reqGap   = math.max(tickReq, traReq, rngReq)                // debug display
// Equivalent to rawGap >= reqGap; only the tick term gets a 0.01-tick float tolerance.
bool  gapPass  = not na(rawGap) and rawGap >= tickReq - EPS and rawGap >= traReq and rawGap >= rngReq
bool  bullCand = rawBull and gapPass
bool  bearCand = rawBear and gapPass

// DEF-L1: pivot at swing bar X = t − right, judged when bar t closes. Strictly beyond
// the `left` bars before X (so a flat top or bottom yields one swing: its first bar)
// and at or beyond the `right` bars after X. Never known before t.
float swHiPx   = high[LIQ_R]
float swLoPx   = low[LIQ_R]
bool  pivHi    = swHiPx > hiL[LIQ_R + 1] and swHiPx >= hiR
bool  pivLo    = swLoPx < loL[LIQ_R + 1] and swLoPx <= loR
// DEF-L2: significance = rejection AND dominance (C1, v0.4.4-dev).
// (a) Rejection: within the confirmation window, price moved away from the swing by at
//     least k × TR average (taken at X).
// (b) Dominance: no high in the W bars BEFORE the swing bar (X−W … X−1; the right bars
//     are not part of it) above the swing high + EQ tolerance (lows mirrored). Only a
//     strictly greater extreme rejects; EPS is the float margin EQ clustering uses.
// Only data up to t is used. A reference still warming up (TR average, or fewer than W
// bars before X) is na: the pivot is warm-up, neither PASS nor REJECT.
float swTra    = liqTra[LIQ_R]
float reactReq = LIQ_K * swTra
float reactHi  = swHiPx - loR
float reactLo  = hiR - swLoPx
float domHiAll = ta.highest(high, math.max(LIQ_W, 1))
float domLoAll = ta.lowest(low, math.max(LIQ_W, 1))
bool  domReady = LIQ_W > 0 and swBar >= LIQ_W
float domHiRef = domReady ? domHiAll[LIQ_R + 1] : na    // highest high of bars X−W … X−1
float domLoRef = domReady ? domLoAll[LIQ_R + 1] : na    // lowest low of bars X−W … X−1
bool  liqWarm  = na(reactReq) or (LIQ_W > 0 and not domReady)
bool  reactHiOk = reactHi >= reactReq
bool  reactLoOk = reactLo >= reactReq
bool  domHiOk  = LIQ_W == 0 or domHiRef <= swHiPx + EQ_TOL + EPS
bool  domLoOk  = LIQ_W == 0 or domLoRef >= swLoPx - EQ_TOL - EPS
bool  sigHi    = pivHi and not liqWarm and reactHiOk and domHiOk
bool  sigLo    = pivLo and not liqWarm and reactLoOk and domLoOk

// ════ L5 · EVENT BUS ═══════════════════════════════════════════════════════════

f_px(float p) =>
    na(p) ? "—" : str.tostring(p, format.mintick)

f_tid(int t) =>
    na(t) ? "—" : str.format_time(t, "yyyy-MM-dd HH:mm", sesTz)

// Logged on history too, so every transition is auditable. No strings are built
// here beyond the short reason code supplied by the caller.
f_emit(int kind, int dir, int sid, int originBar, float price, string reason) =>
    Event e = Event.new(kind, dir, sid, originBar, bar_index, time, price, reason)
    barEv.push(e)
    evLog.push(e)
    if evLog.size() > EV_LOG_MAX
        evLog.shift()
    e

// Liquidity names carry their side (BSL_/SSL_, EQH_/EQL_); Phase 1 names are unchanged.
f_evName(int k, int dir) =>
    string s = dir > 0 ? "BSL_" : "SSL_"
    string q = dir > 0 ? "EQH_" : "EQL_"
    switch k
        EV_FVG_CREATED => "FVG_CREATED"
        EV_FVG_TOUCH   => "FVG_FIRST_TOUCH"
        EV_FVG_CE      => "FVG_CE_TOUCH"
        EV_FVG_FULL    => "FVG_FULL_FILL"
        EV_FVG_INVAL   => "FVG_INVALIDATED"
        EV_FVG_DROPPED => "FVG_DROPPED_MEMORY"
        EV_SES_START   => "SESSION_START"
        EV_SES_END     => "SESSION_END"
        EV_LEVEL_SET   => "LEVEL_SET"
        EV_LIQ_CREATED => s + "CREATED"
        EV_LIQ_TAKEN   => s + "TAKEN"
        EV_LIQ_SWEEP   => s + "SWEEP"
        EV_LIQ_BREAK   => s + "BREAK"
        EV_LIQ_DROPPED => s + "DROPPED_MEMORY"
        EV_EQ_CREATED  => q + "CREATED"
        EV_EQ_TAKEN    => q + "TAKEN"
        EV_EQ_DROPPED  => q + "DROPPED_MEMORY"
        => "UNKNOWN"

f_evText(Event e) =>
    bool   isFvg = e.kind <= EV_FVG_DROPPED
    bool   isLiq = e.kind >= EV_LIQ_CREATED
    string d     = isLiq ? "" : e.dir > 0 ? (isFvg ? " BULL" : " HIGH") : e.dir < 0 ? (isFvg ? " BEAR" : " LOW") : ""
    string id    = e.kind == EV_LEVEL_SET ? "" : " id=" + f_tid(e.sid)
    f_evName(e.kind, e.dir) + d + id + " px=" + f_px(e.price) + (e.reason == "" ? "" : " · " + e.reason)

// ════ L3 · STATE MANAGEMENT (reads no display input) ═══════════════════════════

// ── reference levels ──
method pushExtreme(RefLevel this, float px) =>
    bool better = this.isHigh ? px > this.price : px < this.price
    if better
        this.price      := px
        this.anchorTime := time
    better

method markFinal(RefLevel this) =>
    this.developing := false
    this.knownTime  := time
    this

method supersede(RefLevel this) =>
    this.endTime := time
    this

// DEF-G3: the chart bar that printed the extreme, only when the chart's own
// tracked extreme equals the HTF value; otherwise unknown (na).
f_anchor(float chartPx, int chartT, float htfPx) =>
    not na(chartPx) and not na(htfPx) and math.abs(chartPx - htfPx) < HALF_TICK ? chartT : int(na)

// Replaces the live level of one kind; the superseded instance is handed to L6.
f_roll(int kind, string tag, int dir, float price, int anchorT) =>
    if not na(price)
        RefLevel old = liveLvl.get(kind)
        if not na(old)
            old.supersede()
            lvlEndNow.push(old)
        RefLevel lv = RefLevel.new(kind = kind, tag = tag, isHigh = dir > 0, developing = false, price = price, anchorTime = anchorT, knownTime = time)
        liveLvl.set(kind, lv)
        lvlNewNow.push(lv)
        f_emit(EV_LEVEL_SET, dir, kind, bar_index, price, tag)
    true

// ── sessions ──
// DEF-F4: complete on the first bar outside the window; that is when the final
// high/low become known.
f_sesFinalize(SessionRange s) =>
    s.complete := true
    s.endBar   := bar_index - 1
    s.endTime  := prevT
    s.hi.markFinal()
    s.lo.markFinal()
    sesDirtyNow.push(s)
    f_emit(EV_SES_END, 0, s.id, s.startBar, na, s.name + " H " + f_px(s.hi.price) + " L " + f_px(s.lo.price))
    true

// DEF-F6: superseded by the next instance of the same window.
f_sesSupersede(SessionRange s) =>
    if not s.complete
        f_sesFinalize(s)
    s.hi.supersede()
    s.lo.supersede()
    sesEndNow.push(s)
    true

f_sesNew(int slot, string name) =>
    SessionRange s = SessionRange.new(id = time, slot = slot, name = name, complete = false, startBar = bar_index, startTime = time)
    s.hi := RefLevel.new(kind = -1, tag = name + " H", isHigh = true, developing = true, price = high, anchorTime = time)
    s.lo := RefLevel.new(kind = -1, tag = name + " L", isHigh = false, developing = true, price = low, anchorTime = time)
    sesDirtyNow.push(s)
    f_emit(EV_SES_START, 0, s.id, bar_index, na, name)
    s

// DEF-F3: developing range = running extremes of the bars inside the window.
f_sesExtend(SessionRange s) =>
    bool upH = s.hi.pushExtreme(high)
    bool upL = s.lo.pushExtreme(low)
    if upH or upL
        sesDirtyNow.push(s)
    true

f_sesStep(int slot, bool inNow, bool inPrev, string name) =>
    SessionRange s = liveSes.get(slot)
    // DEF-F2: never start on the first loaded bar (it would be a partial window).
    if inNow and not inPrev and bar_index > 0
        if not na(s)
            f_sesSupersede(s)
        liveSes.set(slot, f_sesNew(slot, name))
    else if not na(s) and not s.complete
        if inNow
            f_sesExtend(s)
        else
            f_sesFinalize(s)
    true

// ── fair value gaps ──
// Display/event policy → the milestone that counts as "mitigated" (DEF-A5).
// Pure reads: the policy never changes what the engine records.
method policyBar(Fvg z) =>
    switch fvgMitRule
        MitRule.firstTouch => z.touchBar
        MitRule.midpoint   => z.ceBar
        MitRule.fullFill   => z.fullBar
        => z.invBar

method policyTime(Fvg z) =>
    switch fvgMitRule
        MitRule.firstTouch => z.touchTime
        MitRule.midpoint   => z.ceTime
        MitRule.fullFill   => z.fullTime
        => z.invTime

// Was the zone confirmed and not yet past its policy milestone at bar b? Taking a
// bar parameter (instead of "now") keeps a future historical-inspection mode
// possible: the same records answer the question for any b in the memory window.
method activeAt(Fvg z, int b) =>
    int pb = z.policyBar()
    z.confirmBar <= b and (na(pb) or pb > b)

method age(Fvg z) =>
    bar_index - z.confirmBar

method fillPct(Fvg z) =>
    float h = z.top - z.bottom
    h <= 0 ? 0.0 : math.max(0.0, math.min(1.0, (z.isBull ? z.top - z.extreme : z.extreme - z.bottom) / h))

// DEF-A4: advances one open zone by one bar and stamps each milestone once.
// Wick milestones only move one way within a bar, so they are safe intrabar;
// invalidation needs a close and runs only on a confirmed bar. DEF-A7: several
// milestones on one bar are all stamped on that bar, in rule order.
method advance(Fvg z) =>
    int d = z.isBull ? 1 : -1
    if z.isBull
        if na(z.touchBar) and low <= z.top
            z.touchBar  := bar_index
            z.touchTime := time
            f_emit(EV_FVG_TOUCH, d, z.id, z.originBar, z.top, "low<=top")
        if na(z.ceBar) and low <= z.mid
            z.ceBar  := bar_index
            z.ceTime := time
            f_emit(EV_FVG_CE, d, z.id, z.originBar, z.mid, "low<=CE")
        if na(z.fullBar) and low <= z.bottom
            z.fullBar  := bar_index
            z.fullTime := time
            f_emit(EV_FVG_FULL, d, z.id, z.originBar, z.bottom, "low<=bottom")
        z.extreme := math.min(z.extreme, low)
        if barstate.isconfirmed and close < z.bottom
            z.invBar  := bar_index
            z.invTime := time
            f_emit(EV_FVG_INVAL, d, z.id, z.originBar, close, "close<bottom")
    else
        if na(z.touchBar) and high >= z.bottom
            z.touchBar  := bar_index
            z.touchTime := time
            f_emit(EV_FVG_TOUCH, d, z.id, z.originBar, z.bottom, "high>=bottom")
        if na(z.ceBar) and high >= z.mid
            z.ceBar  := bar_index
            z.ceTime := time
            f_emit(EV_FVG_CE, d, z.id, z.originBar, z.mid, "high>=CE")
        if na(z.fullBar) and high >= z.top
            z.fullBar  := bar_index
            z.fullTime := time
            f_emit(EV_FVG_FULL, d, z.id, z.originBar, z.top, "high>=top")
        z.extreme := math.max(z.extreme, high)
        if barstate.isconfirmed and close > z.top
            z.invBar  := bar_index
            z.invTime := time
            f_emit(EV_FVG_INVAL, d, z.id, z.originBar, close, "close>top")
    z

// DEF-A6: records stay in memory after invalidation (closed). Only open records
// are advanced; closed ones cost one na() check per bar.
f_fvgStep(array<Fvg> recs) =>
    for z in recs
        if na(z.invBar) and bar_index > z.confirmBar
            z.advance()
    true

// ── liquidity (DEF-L1…L6) ──
// How far this bar traded beyond price p, on the side's side (> 0 = beyond, 0 = exactly at).
method pen(LiqSide s, float p) =>
    s.isBsl ? high - p : p - low

// Nearest price at which anything on this side changes state: an active level when
// the bar reaches its price (take or exact touch), a taken one when the bar goes past
// its furthest excursion, an active cluster when the bar reaches its boundary (DEF-L6 gate).
method trigger(LiqSide s) =>
    float t = na
    for l in s.live
        float v = na(l.takenBar) ? l.price : l.far
        t := na(t) ? v : s.isBsl ? math.min(t, v) : math.max(t, v)
    for c in s.eqs
        if na(c.takenBar)
            t := na(t) ? c.bound : s.isBsl ? math.min(t, c.bound) : math.max(t, c.bound)
    t

// DEF-L4: the factual take, then its interpretation. Take = the bar trades beyond the
// level (one tick is enough; a wick is enough). Classification needs the close, so it
// runs on the confirmed bar only: close strictly beyond → BREAK (accepted beyond);
// close back inside or exactly at the level → SWEEP. Decided on the taking bar and
// never relabelled. (Live mode: TAKEN at the tick, SWEEP/BREAK at the close.)
method take(LiqSide s, Liq l) =>
    int d = s.isBsl ? 1 : -1
    l.takenBar  := bar_index
    l.takenTime := time
    l.takeExt   := s.isBsl ? high : low
    l.far       := l.takeExt
    l.takeGap   := s.isBsl ? open > l.price : open < l.price
    f_emit(EV_LIQ_TAKEN, d, l.id, l.originBar, l.price, "+" + str.tostring(math.round(s.pen(l.price) / syminfo.mintick)) + " ticks" + (l.takeGap ? " · opened beyond" : ""))
    if barstate.isconfirmed
        l.takeClose := close
        l.cls       := (s.isBsl ? close > l.price : close < l.price) ? CLS_BREAK : CLS_SWEEP
        f_emit(l.cls == CLS_BREAK ? EV_LIQ_BREAK : EV_LIQ_SWEEP, d, l.id, l.originBar, l.price, "close " + f_px(close))
    l

// An EQ cluster is taken when the bar trades beyond its current boundary (all members'
// stops). Individual member takes are separate facts on the members (DEF-L5.3).
method takeEq(LiqSide s, EqCluster c) =>
    c.takenBar  := bar_index
    c.takenTime := time
    if barstate.isconfirmed
        c.cls := (s.isBsl ? close > c.bound : close < c.bound) ? CLS_BREAK : CLS_SWEEP
    if not na(c.qualBar)
        f_emit(EV_EQ_TAKEN, s.isBsl ? 1 : -1, c.id, c.originBar, c.bound, str.tostring(c.members.size()) + " swings" + (c.cls == CLS_BREAK ? " · break" : c.cls == CLS_SWEEP ? " · sweep" : ""))
    c

// DEF-L6: advances one side by one bar. Nothing is scanned unless the bar reaches the
// side's trigger price, so a quiet bar costs one comparison. Never on the bar that
// confirmed a level (that bar cannot exceed it anyway, by DEF-L1).
method step(LiqSide s) =>
    if not na(s.trig) and s.pen(s.trig) >= 0
        int n = s.live.size()
        if n > 0
            for i = n - 1 to 0
                Liq l = s.live.get(i)
                if bar_index > l.confirmBar
                    float p = s.pen(l.price)
                    if na(l.takenBar)
                        if p > 0
                            s.take(l)
                        else if p == 0
                            l.touches := l.touches + 1
                    else if s.pen(l.far) > 0
                        l.far := s.isBsl ? high : low
                    // DEF-L5: beyond price ± tolerance the level can never be part of
                    // an intact equal-highs/lows pool again: it closes.
                    if not na(l.takenBar) and p > EQ_TOL + EPS
                        l.eqOpen := false
                        s.hist.push(s.live.remove(i))
        for c in s.eqs
            if na(c.takenBar) and s.pen(c.bound) > 0
                s.takeEq(c)
        s.trig := s.trigger()
    s

// Deliberate, logged. Oldest taken cluster first; an active one only when all are
// active, and then its members are released (they no longer hide behind it).
method dropCluster(LiqSide s) =>
    int victim = 0
    for i = 0 to s.eqs.size() - 2
        if not na(s.eqs.get(i).takenBar)
            victim := i
            break
    EqCluster old = s.eqs.remove(victim)
    if na(old.takenBar)
        for m in s.live
            if not na(m.eq) and m.eq.id == old.id
                m.eq := na
    s.dropEq := s.dropEq + 1
    f_emit(EV_EQ_DROPPED, s.isBsl ? 1 : -1, old.id, old.originBar, old.bound, na(old.takenBar) ? "active cluster · tracking stopped" : "taken cluster")
    true

// DEF-L5: EQ clustering for a new level `l` (not yet in s.live).
//  1. Join the nearest ACTIVE cluster whose boundary is within tolerance.
//  2. Otherwise form a cluster with the nearest earlier level that is in no cluster,
//     within tolerance, and whose pool is intact: untaken (then l is at or inside
//     it), or taken but nothing has traded beyond l since (then l is the new edge).
// Ties go to the newest. A level belongs to at most one cluster. A join keeps the
// cluster's id and ref and can only move `bound` outward. Nothing is re-evaluated
// on past bars: a new boundary can be taken from the next bar on (DEF-L5.5).
method cluster(LiqSide s, Liq l) =>
    int       d    = s.isBsl ? 1 : -1
    EqCluster hit  = na
    float     best = na
    for c in s.eqs
        float dist = math.abs(l.price - c.bound)
        if na(c.takenBar) and dist <= EQ_TOL + EPS and (na(best) or dist <= best)
            best := dist
            hit  := c
    if na(hit)
        Liq seed = na
        for m in s.live
            float dist   = math.abs(l.price - m.price)
            bool  intact = na(m.takenBar) or (s.isBsl ? l.price >= m.far : l.price <= m.far)
            if na(m.eq) and intact and dist <= EQ_TOL + EPS and (na(best) or dist <= best)
                best := dist
                seed := m
        if not na(seed)
            float edge = s.isBsl ? math.max(seed.price, l.price) : math.min(seed.price, l.price)
            hit := EqCluster.new(id = time, isHigh = s.isBsl, ref = edge, bound = edge, members = array.from(seed.id), originBar = seed.originBar, originTime = seed.originTime)
            seed.eq := hit
            s.eqs.push(hit)
            if s.eqs.size() > EQ_MEM
                s.dropCluster()
    if not na(hit)
        hit.members.push(l.id)
        hit.bound    := s.isBsl ? math.max(hit.bound, l.price) : math.min(hit.bound, l.price)
        hit.lastBar  := bar_index
        hit.lastTime := time
        l.eq := hit
        if na(hit.qualBar) and hit.members.size() >= eqMinTch
            hit.qualBar  := bar_index
            hit.qualTime := time
            f_emit(EV_EQ_CREATED, d, hit.id, hit.originBar, hit.bound, str.tostring(hit.members.size()) + " swings within " + str.tostring(eqTolTk) + " ticks")
    hit

// DEF-L1…L3, L5: a confirmed, significant swing becomes a level, is clustered, then
// the side's memory policy runs (deliberate and logged, like FVG memory).
method register(LiqSide s, float px, int oBar, int oTime, float react, float req, float tra) =>
    int d = s.isBsl ? 1 : -1
    Liq l = Liq.new(id = oTime, isBsl = s.isBsl, price = px, originBar = oBar, originTime = oTime, confirmBar = bar_index, confirmTime = time, pivL = LIQ_L, pivR = LIQ_R, react = react, reactReq = req, tra = tra)
    f_emit(EV_LIQ_CREATED, d, l.id, oBar, px, "reaction " + str.tostring(react / tra, "#.##") + "×TR ≥ " + str.tostring(LIQ_K, "#.##"))
    s.cluster(l)
    s.live.push(l)
    s.levels := s.levels + 1
    s.trig   := na(s.trig) ? px : s.isBsl ? math.min(s.trig, px) : math.max(s.trig, px)
    if s.live.size() + s.hist.size() > liqMemory
        bool fromHist = s.hist.size() > 0
        Liq  old      = na
        if fromHist
            old        := s.hist.shift()
            s.dropHist := s.dropHist + 1
        else
            old        := s.live.shift()
            s.dropLive := s.dropLive + 1
            s.trig     := s.trigger()
        f_emit(EV_LIQ_DROPPED, d, old.id, old.originBar, old.price, fromHist ? "closed record" : "live record · tracking stopped")
    l

// ════ L6 · RENDERER (functions: read state, write drawing handles only) ═════════

int rightT = time + rightOffset * TF_MS   // where "extends to now" ends

// ── levels ──
f_lvlVisible(int k) =>
    k <= K_PDL ? pdShow : k <= K_PWL ? pwShow : k == K_DO ? doShow : moShow

f_lvlCol(int k) =>
    k <= K_PDL ? pdCol : k <= K_PWL ? pwCol : k == K_DO ? doCol : moCol

f_lvlStyle(int k) =>
    k <= K_PDL ? PD_STYLE : k <= K_PWL ? PW_STYLE : k == K_DO ? line.style_dotted : line.style_dashed

// Session lines always start at their extreme; period levels follow the anchor
// preference and fall back to the time the level became known.
method x1(RefLevel this) =>
    (this.kind < 0 or lvlAnchor) and not na(this.anchorTime) ? this.anchorTime : this.knownTime

method drawLine(RefLevel this, color col, string style, bool withLabel) =>
    this.ln := line.new(this.x1(), this.price, rightT, this.price, xloc = xloc.bar_time, color = col, style = style, width = 1)
    if withLabel
        this.lbl := label.new(rightT, this.price, this.tag, xloc = xloc.bar_time, style = label.style_label_left, color = CLR_NONE, textcolor = col, size = LBL_SIZE)
    this

// Idempotent: safe on every realtime tick.
method syncLine(RefLevel this, color col, string style) =>
    bool  ended = not na(this.endTime)
    color c     = this.developing and not sesDev ? CLR_NONE : ended ? color.new(col, T_HIST) : col
    if not na(this.ln)
        this.ln.set_xy1(this.x1(), this.price)
        this.ln.set_xy2(ended ? this.endTime : rightT, this.price)
        this.ln.set_color(c)
        this.ln.set_style(this.developing ? line.style_dotted : style)
    if not na(this.lbl)
        if ended
            label.delete(this.lbl)
            this.lbl := na
        else
            this.lbl.set_xy(rightT, this.price)
            this.lbl.set_textcolor(c)
            this.lbl.set_tooltip(this.tag + "  " + f_px(this.price))
    this

method eraseLine(RefLevel this) =>
    line.delete(this.ln)
    label.delete(this.lbl)
    this.ln  := na
    this.lbl := na
    this

// ── sessions ──
f_sesVisible(int slot) =>
    slot == 0 ? s1Show : slot == 1 ? s2Show : slot == 2 ? s3Show : s4Show

f_sesCol(int slot) =>
    slot == 0 ? s1Cl : slot == 1 ? s2Cl : slot == 2 ? s3Cl : s4Cl

f_sesDraw(SessionRange s) =>
    color col = f_sesCol(s.slot)
    if sesHL and na(s.hi.ln)
        s.hi.drawLine(col, line.style_solid, sesLabels)
        s.lo.drawLine(col, line.style_solid, sesLabels)
    if showSesBox and na(s.area)
        s.area := box.new(s.startTime, s.hi.price, s.startTime, s.lo.price, xloc = xloc.bar_time, bgcolor = color.new(col, 94), border_color = color.new(col, 78), text = s.name, text_size = size.tiny, text_color = color.new(col, 35), text_halign = text.align_left, text_valign = text.align_top)
    if showSesMid and na(s.mid)
        s.mid := line.new(s.startTime, hl2, s.startTime, hl2, xloc = xloc.bar_time, color = color.new(col, 45), style = line.style_dotted, width = 1)
    true

f_sesSync(SessionRange s) =>
    color col   = f_sesCol(s.slot)
    int   right = s.complete ? s.endTime : time
    float m     = (s.hi.price + s.lo.price) / 2
    s.hi.syncLine(col, line.style_solid)
    s.lo.syncLine(col, line.style_solid)
    if not na(s.area)
        s.area.set_lefttop(s.startTime, s.hi.price)
        s.area.set_rightbottom(right, s.lo.price)
    if not na(s.mid)
        s.mid.set_xy1(s.startTime, m)
        s.mid.set_xy2(right, m)
    true

f_sesErase(SessionRange s) =>
    s.hi.eraseLine()
    s.lo.eraseLine()
    box.delete(s.area)
    line.delete(s.mid)
    s.area := na
    s.mid  := na
    true

// Visual history, capped per session slot.
f_sesHistPush(SessionRange s) =>
    histSes.push(s)
    int cnt = 0
    for x in histSes
        if x.slot == s.slot
            cnt += 1
    if cnt > sesHist
        for i = 0 to histSes.size() - 1
            if histSes.get(i).slot == s.slot
                f_sesErase(histSes.remove(i))
                break
    true

// ── fair value gaps ──
f_fvgText(Fvg z) =>
    if dbgOn
        (z.isBull ? "▲ " : "▼ ") + str.format_time(z.id, "HH:mm", sesTz) + (na(z.touchBar) ? "" : " T") + (na(z.ceBar) ? "" : " C") + (na(z.fullBar) ? "" : " F") + " · " + str.tostring(math.round(z.fillPct() * 100)) + "%"
    else
        "FVG"

method leftT(Fvg z) =>
    fvgAnchor == ZoneAnchor.origin ? z.originTime : z.confirmTime

method undraw(Fvg z) =>
    box.delete(z.zone)
    line.delete(z.ce)
    z.zone := na
    z.ce   := na
    z

// Create-or-update the active view of a zone.
method drawActive(Fvg z) =>
    color  col     = z.isBull ? fvgBullCol : fvgBearCol
    bool   touched = not na(z.touchBar)
    float  top     = fvgShrink and touched and z.isBull ? math.max(z.bottom, math.min(z.top, z.extreme)) : z.top
    float  bot     = fvgShrink and touched and not z.isBull ? math.min(z.top, math.max(z.bottom, z.extreme)) : z.bottom
    int    right   = fvgExtend ? rightT : z.confirmTime + rightOffset * TF_MS
    color  bg      = touched ? color.new(col, math.min(100, color.t(col) + 6)) : col
    string txt     = showFvgTxt ? f_fvgText(z) : ""
    if na(z.zone)
        z.zone := box.new(z.leftT(), top, right, bot, xloc = xloc.bar_time, bgcolor = bg, border_color = CLR_NONE, text = txt, text_size = size.tiny, text_color = color.new(col, 25), text_halign = text.align_right, text_valign = text.align_center)
        if showCE
            z.ce := line.new(z.leftT(), z.mid, right, z.mid, xloc = xloc.bar_time, color = color.new(col, 45), style = line.style_dotted, width = 1)
    else
        z.zone.set_top(top)
        z.zone.set_bottom(bot)
        z.zone.set_right(right)
        z.zone.set_bgcolor(bg)
        z.zone.set_text(txt)
        if not na(z.ce)
            z.ce.set_x2(right)
    z

// Frozen view ending at the bar the policy was met (original bounds).
method drawFaded(Fvg z) =>
    color col = z.isBull ? fvgBullCol : fvgBearCol
    int   endT = z.policyTime()
    z.zone := box.new(z.leftT(), z.top, endT, z.bottom, xloc = xloc.bar_time, bgcolor = color.new(col, T_FADED), border_color = CLR_NONE, text = dbgOn ? str.format_time(z.id, "HH:mm", sesTz) + " · mitigated" : "", text_size = size.tiny, text_color = color.new(col, 40), text_halign = text.align_right, text_valign = text.align_center)
    if showCE
        z.ce := line.new(z.leftT(), z.mid, endT, z.mid, xloc = xloc.bar_time, color = color.new(col, 85), style = line.style_dotted, width = 1)
    z

// Visual transition when a zone meets the display policy on this bar.
f_onPolicyMet(Fvg z) =>
    z.undraw()
    if fvgShow and keepFaded
        z.drawFaded()
        fadedFvg.push(z)
        while fadedFvg.size() > fvgMaxFaded
            fadedFvg.shift().undraw()
    true

method metNow(Fvg z) =>
    int pb = z.policyBar()
    not na(pb) and pb == bar_index

f_fadeNew(array<Fvg> recs) =>
    for z in recs
        if z.metNow()
            f_onPolicyMet(z)
    true

// Exact reconciliation as of bar `b`: the newest `fvgMaxVis` zones active at b are
// drawn; every other zone active at b is undrawn. Faded views are not touched.
f_renderActive(array<Fvg> recs, int b) =>
    int shown = 0
    int n     = recs.size()
    if n > 0
        for i = n - 1 to 0
            Fvg z = recs.get(i)
            if z.activeAt(b)
                if fvgShow and shown < fvgMaxVis and (fvgMaxAge == 0 or z.age() <= fvgMaxAge)
                    shown += 1
                    z.drawActive()
                else
                    z.undraw()
    shown

// ── liquidity (DEF-L7). Pure reads of L3; the only writes are to the renderer's own
//    object pool and counters. ──
f_liqCol(bool isBsl) =>
    isBsl ? liqBslCol : liqSslCol

// A visible reference line (PDH/PDL/PWH/PWL, live session high/low) already sits at
// this exact price: the same horizontal line is not drawn twice. Rendering only.
f_onRefLine(float px) =>
    bool hit = false
    for k = K_PDH to K_PWL
        RefLevel lv = liveLvl.get(k)
        if not na(lv) and f_lvlVisible(k) and math.abs(lv.price - px) < HALF_TICK
            hit := true
    if sesHL
        for s in liveSes
            if not na(s) and f_sesVisible(s.slot) and (s.complete or sesDev) and (math.abs(s.hi.price - px) < HALF_TICK or math.abs(s.lo.price - px) < HALF_TICK)
                hit := true
    hit

// Members of a displayed EQ cluster are represented by the cluster's line.
method inShownEq(Liq l) =>
    eqShow and not na(l.eq) and na(l.eq.takenBar) and not na(l.eq.qualBar)

method startT(Liq l) =>
    liqAnchor == LiqAnchor.origin ? l.originTime : l.confirmTime

f_liqLine(int x1, int x2, float px, color col, string sty, int w) =>
    liqLns.push(line.new(x1, px, x2, px, xloc = xloc.bar_time, color = col, style = sty, width = w))

f_liqLabel(int x, float px, string txt, color col, string tip) =>
    liqLbls.push(label.new(x, px, txt, xloc = xloc.bar_time, style = label.style_label_left, color = CLR_NONE, textcolor = col, size = size.tiny, tooltip = tip))

// Active levels: the `liqMaxVis` nearest to the close (all active BSL are above price,
// all active SSL below), newest first on ties. Levels merged into a reference line
// or a shown EQ cluster do not use a slot.
f_drawActive(LiqSide s, int slot) =>
    color col    = f_liqCol(s.isBsl)
    int   n      = s.live.size()
    int   shown  = 0
    int   merged = 0
    if (s.isBsl ? liqShowBsl : liqShowSsl) and liqMaxVis > 0 and n > 0
        array<bool> used = array.new<bool>(n, false)
        while shown < liqMaxVis
            int   pick = -1
            float best = na
            for i = n - 1 to 0
                Liq cand = s.live.get(i)
                if not used.get(i) and na(cand.takenBar) and not cand.inShownEq()
                    float dd = math.abs(close - cand.price)
                    if na(best) or dd < best
                        best := dd
                        pick := i
            if pick < 0
                break
            used.set(pick, true)
            Liq l = s.live.get(pick)
            if f_onRefLine(l.price)
                merged += 1
                continue
            shown += 1
            f_liqLine(l.startT(), rightT, l.price, col, line.style_solid, 1)
            if showLiqTxt
                f_liqLabel(rightT, l.price, s.isBsl ? "BSL" : "SSL", col, (s.isBsl ? "BSL " : "SSL ") + f_px(l.price) + "\nswing " + f_tid(l.originTime) + " · known " + f_tid(l.confirmTime) + "\nreaction " + str.tostring(l.react / l.tra, "#.##") + "×TR · exact touches " + str.tostring(l.touches))
    liqCnt.set(slot, shown)
    liqCnt.set(6, liqCnt.get(6) + merged)
    shown

// Taken levels: the `liqMaxTkn` most recently taken, of the classes switched on.
f_drawTaken(LiqSide s, int slot) =>
    color col   = color.new(f_liqCol(s.isBsl), T_TAKEN)
    int   shown = 0
    if (s.isBsl ? liqShowBsl : liqShowSsl) and (liqShowSwp or liqShowBrk) and liqMaxTkn > 0 and not minimalMode
        array<Liq> pool = s.hist.copy()
        pool.concat(s.live)
        int n = pool.size()
        if n > 0
            array<bool> used = array.new<bool>(n, false)
            while shown < liqMaxTkn
                int pick = -1
                int best = na
                for i = n - 1 to 0
                    Liq  cand = pool.get(i)
                    bool want = not na(cand.takenBar) and (cand.cls == CLS_SWEEP ? liqShowSwp : cand.cls == CLS_BREAK ? liqShowBrk : true)
                    if not used.get(i) and want and (na(best) or cand.takenTime > best)
                        best := cand.takenTime
                        pick := i
                if pick < 0
                    break
                used.set(pick, true)
                Liq    l   = pool.get(pick)
                string tag = l.cls == CLS_SWEEP ? "sweep" : l.cls == CLS_BREAK ? "break" : "taken"
                shown += 1
                f_liqLine(l.startT(), l.takenTime, l.price, col, line.style_dotted, 1)
                if showLiqTxt
                    f_liqLabel(l.takenTime, l.price, tag, col, (s.isBsl ? "BSL " : "SSL ") + f_px(l.price) + " " + tag + " " + f_tid(l.takenTime) + "\nextreme " + f_px(l.takeExt) + " · close " + f_px(l.takeClose))
    liqCnt.set(slot, shown)
    shown

// Active EQ clusters that reached the minimum touches: the `eqMaxVis` nearest.
f_drawEq(LiqSide s, int slot) =>
    color col    = f_liqCol(s.isBsl)
    int   n      = s.eqs.size()
    int   shown  = 0
    int   merged = 0
    if eqShow and eqMaxVis > 0 and n > 0
        array<bool> used = array.new<bool>(n, false)
        while shown < eqMaxVis
            int   pick = -1
            float best = na
            for i = n - 1 to 0
                EqCluster cand = s.eqs.get(i)
                if not used.get(i) and na(cand.takenBar) and not na(cand.qualBar)
                    float dd = math.abs(close - cand.bound)
                    if na(best) or dd < best
                        best := dd
                        pick := i
            if pick < 0
                break
            used.set(pick, true)
            EqCluster c = s.eqs.get(pick)
            if f_onRefLine(c.bound)
                merged += 1
                continue
            shown += 1
            string tag = (s.isBsl ? "EQH ×" : "EQL ×") + str.tostring(c.members.size())
            f_liqLine(liqAnchor == LiqAnchor.origin ? c.originTime : c.qualTime, rightT, c.bound, col, line.style_solid, 2)
            if showLiqTxt
                f_liqLabel(rightT, c.bound, tag, col, tag + " " + f_px(c.bound) + "\nfirst swing " + f_tid(c.originTime) + " · EQ known " + f_tid(c.qualTime))
    liqCnt.set(slot, shown)
    liqCnt.set(6, liqCnt.get(6) + merged)
    shown

// ════ ENGINE RUN · L1 → L2/L4 → L3 → L5 (fixed order) ══════════════════════════

barEv.clear()
fvgDropNow.clear()
lvlNewNow.clear()
lvlEndNow.clear()
sesDirtyNow.clear()
sesEndNow.clear()

if engineTick
    // ── Levels (DEF-G1…G6). Always computed; display inputs are read by L6 only. ──
    // barstate.isfirst seeds levels on the first loaded bar: on 1m, the start of
    // the current week is usually not in history.
    bool rollD = newDay or barstate.isfirst
    bool rollW = newWeek or barstate.isfirst
    if rollD
        // DEF-G6: chart-aggregated trading day vs the HTF daily bar, complete days only.
        if intraday and dFull and newDay and not na(pdH)
            pdN += 1
            if math.abs(dHi - pdH) >= HALF_TICK or math.abs(dLo - pdL) >= HALF_TICK
                pdBad  += 1
                pdBadT := time
        if intraday
            f_roll(K_PDH, "PDH", 1, pdH, f_anchor(dHi, dHiT, pdH))
            f_roll(K_PDL, "PDL", -1, pdL, f_anchor(dLo, dLoT, pdL))
            if newDay and not barstate.isfirst
                f_roll(K_DO, "DO", 0, open, time)
        dFull   := not barstate.isfirst
        dStartT := time
        dHi     := high
        dHiT    := time
        dLo     := low
        dLoT    := time
    else
        if high > dHi
            dHi  := high
            dHiT := time
        if low < dLo
            dLo  := low
            dLoT := time
    if rollW
        if (intraday or timeframe.isdaily) and wFull and newWeek and not na(pwH)
            pwN += 1
            if math.abs(wHi - pwH) >= HALF_TICK or math.abs(wLo - pwL) >= HALF_TICK
                pwBad  += 1
                pwBadT := time
        if intraday or timeframe.isdaily
            f_roll(K_PWH, "PWH", 1, pwH, f_anchor(wHi, wHiT, pwH))
            f_roll(K_PWL, "PWL", -1, pwL, f_anchor(wLo, wLoT, pwL))
        wFull   := not barstate.isfirst
        wStartT := time
        wHi     := high
        wHiT    := time
        wLo     := low
        wLoT    := time
    else
        if high > wHi
            wHi  := high
            wHiT := time
        if low < wLo
            wLo  := low
            wLoT := time
    if atMidnight and sesTfOk
        f_roll(K_MO, "MO", 0, open, time)

    // ── Sessions (DEF-F1…F6). Hidden sessions are tracked identically. ──
    f_sesStep(0, inS1, inS1[1], s1Nm)
    f_sesStep(1, inS2, inS2[1], s2Nm)
    f_sesStep(2, inS3, inS3[1], s3Nm)
    f_sesStep(3, inS4, inS4[1], s4Nm)

    // ── FVG (DEF-A1…A7). Existing records advance first, then the new one is
    //    registered, so a zone is never touched by the candle that created it. ──
    f_fvgStep(bullFvgs)
    f_fvgStep(bearFvgs)
    if barstate.isconfirmed and (bullCand or bearCand)
        bool  up  = bullCand
        int   d   = up ? 1 : -1
        float top = up ? low : c1Low
        float bot = up ? c1High : high
        Fvg z = Fvg.new(id = time, isBull = up, tf = timeframe.period, originBar = bar_index - 2, originTime = c1Time, confirmBar = bar_index, confirmTime = time, top = top, bottom = bot, mid = (top + bot) / 2, sizeTra = (top - bot) / refTra, thrTick = tickReq, thrTra = traReq, thrRng = rngReq, extreme = up ? top : bot)
        array<Fvg> recs = up ? bullFvgs : bearFvgs
        recs.push(z)
        f_emit(EV_FVG_CREATED, d, z.id, z.originBar, z.mid, f_px(bot) + "–" + f_px(top))
        // DEF-A6: deliberate logical deletion. Oldest closed record first; an open
        // record only when every record of this direction is still open.
        if recs.size() > fvgMemory
            int victim = 0
            for i = 0 to recs.size() - 2
                if not na(recs.get(i).invBar)
                    victim := i
                    break
            Fvg  old    = recs.remove(victim)
            bool wasOpen = na(old.invBar)
            if wasOpen
                dropOpen += 1
            else
                dropClosed += 1
            fvgDropNow.push(old)
            f_emit(EV_FVG_DROPPED, d, old.id, old.originBar, old.mid, wasOpen ? "open record · lifecycle tracking stopped" : "closed record")

    // ── Liquidity (DEF-L1…L6). Runs after Phase 1 and reads no Phase 1 state.
    //    Existing levels advance first, then this bar's confirmations register, so a
    //    level is never taken by the bar that confirmed it. Pivots need the close. ──
    if liqOn
        bslS.step()
        sslS.step()
        if barstate.isconfirmed
            if pivHi
                bslS.pivots := bslS.pivots + 1
                if sigHi
                    bslS.register(swHiPx, swBar, swTime, reactHi, reactReq, swTra)
                else if not liqWarm
                    bslS.rejects := bslS.rejects + 1
                    bslS.rejReact := bslS.rejReact + (not reactHiOk and domHiOk ? 1 : 0)
                    bslS.rejDom := bslS.rejDom + (reactHiOk and not domHiOk ? 1 : 0)
                    bslS.rejBoth := bslS.rejBoth + (not reactHiOk and not domHiOk ? 1 : 0)
            if pivLo
                sslS.pivots := sslS.pivots + 1
                if sigLo
                    sslS.register(swLoPx, swBar, swTime, reactLo, reactReq, swTra)
                else if not liqWarm
                    sslS.rejects := sslS.rejects + 1
                    sslS.rejReact := sslS.rejReact + (not reactLoOk and domLoOk ? 1 : 0)
                    sslS.rejDom := sslS.rejDom + (reactLoOk and not domLoOk ? 1 : 0)
                    sslS.rejBoth := sslS.rejBoth + (not reactLoOk and not domLoOk ? 1 : 0)

// ════ L6 · RENDERER (run) ══════════════════════════════════════════════════════

// Levels: superseded instances freeze and join the capped visual history.
for lv in lvlEndNow
    lv.syncLine(f_lvlCol(lv.kind), f_lvlStyle(lv.kind))
    if not na(lv.ln)
        histLvl.push(lv)
        while histLvl.size() > lvlHist
            histLvl.shift().eraseLine()
for lv in lvlNewNow
    if f_lvlVisible(lv.kind)
        lv.drawLine(f_lvlCol(lv.kind), f_lvlStyle(lv.kind), lvlLabels)
        lv.syncLine(f_lvlCol(lv.kind), f_lvlStyle(lv.kind))

// Sessions: changed instances are (re)drawn; superseded ones go to history.
for s in sesDirtyNow
    if f_sesVisible(s.slot)
        f_sesDraw(s)
        f_sesSync(s)
for s in sesEndNow
    f_sesSync(s)
    if not na(s.hi.ln) or not na(s.area) or not na(s.mid)
        f_sesHistPush(s)

// FVG: a record dropped by memory loses its active view; if it met the policy on
// this very bar it still gets its faded view. Then policy transitions of this bar.
for z in fvgDropNow
    if z.metNow()
        f_onPolicyMet(z)
    else if z.activeAt(bar_index)
        z.undraw()
f_fadeNew(bullFvgs)
f_fadeNew(bearFvgs)

// Everything that "extends to now" is reconciled once, on the last bar.
int shownBull = 0
int shownBear = 0
if barstate.islast
    shownBull := f_renderActive(bullFvgs, bar_index)
    shownBear := f_renderActive(bearFvgs, bar_index)
    for lv in liveLvl
        if not na(lv)
            lv.syncLine(f_lvlCol(lv.kind), f_lvlStyle(lv.kind))
    for s in liveSes
        if not na(s)
            f_sesSync(s)

// Forming-FVG preview: provisional, one slot, rebuilt every tick, never logged.
var box devBox = na
if barstate.islast
    box.delete(devBox)
    devBox := na
    if fvgShow and fvgPreview and not confirmedOnly and not barstate.isconfirmed and (bullCand or bearCand)
        color pc = bullCand ? fvgBullCol : fvgBearCol
        int   pl = fvgAnchor == ZoneAnchor.origin ? c1Time : time
        devBox := box.new(pl, bullCand ? low : c1Low, rightT, bullCand ? c1High : high, xloc = xloc.bar_time, bgcolor = color.new(pc, 94), border_color = color.new(pc, 35), border_style = line.style_dashed, text = "forming · provisional", text_size = size.tiny, text_color = color.new(pc, 25), text_halign = text.align_right, text_valign = text.align_center)

// Liquidity (DEF-L7): the whole view is rebuilt from state on the last bar. Nothing is
// drawn on history and nothing persists between bars, so drawings can never diverge
// from logical state, and hiding a level never touches it.
if barstate.islast
    for x in liqLns
        line.delete(x)
    for x in liqLbls
        label.delete(x)
    liqLns.clear()
    liqLbls.clear()
    liqCnt.fill(0)
    if liqOn
        f_drawEq(bslS, 2)
        f_drawEq(sslS, 3)
        f_drawActive(bslS, 0)
        f_drawActive(sslS, 1)
        f_drawTaken(bslS, 4)
        f_drawTaken(sslS, 5)

// ════ L7 · ALERTS ══════════════════════════════════════════════════════════════
// Alert toggles filter delivery only; every event is logged regardless.

f_alertOn(Event e) =>
    switch e.kind
        EV_FVG_CREATED => e.dir > 0 ? alBullNew : alBearNew
        EV_FVG_TOUCH   => alTouch
        EV_FVG_CE      => alCE
        EV_FVG_FULL    => alFull
        EV_FVG_INVAL   => alInval
        EV_LIQ_TAKEN   => alLiqTkn
        EV_LIQ_SWEEP   => alLiqSwp
        EV_LIQ_BREAK   => alLiqBrk
        EV_EQ_TAKEN    => alEqTkn
        => false

varip int    firedBar  = -1
varip string firedKeys = ""
if barstate.isrealtime and barEv.size() > 0
    string head = syminfo.ticker + " " + timeframe.period + " · "
    if alTiming == AlertTiming.barClose
        // The closing tick replays the bar from rolled-back state, so its event
        // list equals the historical event list of that bar.
        if barstate.isconfirmed
            string msg = ""
            for e in barEv
                if f_alertOn(e)
                    msg += (msg == "" ? "" : " | ") + f_evText(e)
            if msg != ""
                alert(head + msg, alert.freq_once_per_bar_close)
    else
        // Experimental: varip survives rollback, so each event key fires once per bar.
        if firedBar != bar_index
            firedBar  := bar_index
            firedKeys := "|"
        string fresh = ""
        for e in barEv
            // dir is part of the key: a BSL and an SSL can share a swing-bar id.
            string k = str.tostring(e.kind) + ":" + str.tostring(e.dir) + ":" + str.tostring(e.sid)
            if f_alertOn(e) and not str.contains(firedKeys, "|" + k + "|")
                firedKeys += k + "|"
                fresh     += (fresh == "" ? "" : " | ") + f_evText(e)
        if fresh != ""
            alert(head + fresh, alert.freq_all)

// ════ L7 · DIAGNOSTICS (one table, no drawing objects) ═════════════════════════

var table dbgTbl  = dbgOn ? table.new(position.bottom_right, 2, 35, bgcolor = color.new(#131722, 10), frame_color = #363A45, frame_width = 1, border_width = 0) : na
var table warnTbl = table.new(position.top_right, 1, 2)
var int   dbgFirstT = time    // first loaded bar: where a replay of the history must start

f_dbgRow(int r, string k, string v) =>
    table.cell(dbgTbl, 0, r, k, text_color = #787B86, text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top)
    table.cell(dbgTbl, 1, r, v, text_color = #D1D4DC, text_size = size.tiny, text_halign = text.align_left)
    true

f_mt(int t) =>
    na(t) ? "—" : str.format_time(t, "MM-dd HH:mm", sesTz)

// Thresholds are not on the tick grid: print them unrounded.
f_num(float x) =>
    na(x) ? "—" : str.tostring(x, "#.####")

f_ruleName() =>
    switch fvgMitRule
        MitRule.firstTouch => "first touch"
        MitRule.midpoint   => "CE"
        MitRule.fullFill   => "full fill"
        => "close through"

f_countOpen(array<Fvg> recs) =>
    int c = 0
    for z in recs
        if na(z.invBar)
            c += 1
    c

// n-th newest record across both directions (by confirmation time).
f_nthNewest(int n) =>
    int ib   = bullFvgs.size() - 1
    int ir   = bearFvgs.size() - 1
    Fvg pick = na
    for k = 0 to n
        Fvg b = na
        Fvg r = na
        if ib >= 0
            b := bullFvgs.get(ib)
        if ir >= 0
            r := bearFvgs.get(ir)
        if na(b) and na(r)
            pick := na
            break
        if na(r) or (not na(b) and b.confirmTime > r.confirmTime)
            pick := b
            ib   -= 1
        else
            pick := r
            ir   -= 1
    pick

f_sesState(SessionRange s) =>
    string out = "—"
    if not na(s)
        out := (s.complete ? "DONE " : "LIVE ") + f_mt(s.startTime) + (s.complete ? "→" + str.format_time(s.endTime, "HH:mm", sesTz) : "") + " · " + f_px(s.hi.price) + " / " + f_px(s.lo.price)
    out

f_lvlPx(int k) =>
    RefLevel lv = liveLvl.get(k)
    na(lv) ? "—" : f_px(lv.price)

f_check(int n, int bad, int badT) =>
    n == 0 ? "no complete period on chart yet" : str.tostring(n - bad) + "/" + str.tostring(n) + " match" + (bad > 0 ? " · last ✗ " + str.format_time(badT, "yyyy-MM-dd", sesTz) : "")

f_lastEvents(int n) =>
    string out = ""
    int sz = evLog.size()
    if sz > 0
        for i = sz - 1 to math.max(0, sz - n)
            Event e = evLog.get(i)
            out += (out == "" ? "" : "\n") + f_mt(e.eventTime) + "  " + f_evText(e)
    out

f_presetName() =>
    switch liqPreset
        LiqPreset.aggressive => "Aggressive"
        LiqPreset.balanced   => "Balanced"
        LiqPreset.strict     => "Strict"
        => "Custom"

f_clsName(int c) =>
    c == CLS_SWEEP ? "SWEEP" : c == CLS_BREAK ? "BREAK" : "unclassified (bar open)"

// active · taken (sweep / break) · memory use · drops, for one side.
f_liqSideState(LiqSide s) =>
    array<Liq> all = s.hist.copy()
    all.concat(s.live)
    int act = 0
    int swp = 0
    int brk = 0
    for l in all
        if na(l.takenBar)
            act += 1
        else if l.cls == CLS_SWEEP
            swp += 1
        else if l.cls == CLS_BREAK
            brk += 1
    "active " + str.tostring(act) + " · taken " + str.tostring(all.size() - act) + " (sweep " + str.tostring(swp) + " · break " + str.tostring(brk) + ") · memory " + str.tostring(all.size()) + "/" + str.tostring(liqMemory) + " · dropped " + str.tostring(s.dropLive) + " live + " + str.tostring(s.dropHist) + " closed"

f_eqState(LiqSide s) =>
    int act = 0
    int tkn = 0
    int frm = 0
    for c in s.eqs
        if na(c.qualBar)
            frm += 1
        else if na(c.takenBar)
            act += 1
        else
            tkn += 1
    str.tostring(act) + " active · " + str.tostring(tkn) + " taken · " + str.tostring(frm) + " below min"

// Selectivity on the loaded history: pivots → significance PASS / REJECT → levels.
f_selectivity(LiqSide s) =>
    int judged = s.levels + s.rejects
    str.tostring(s.pivots) + " pivots · PASS " + str.tostring(s.levels) + " · REJECT " + str.tostring(s.rejects) + (judged > 0 ? " (" + str.tostring(100.0 * s.rejects / judged, "#.#") + "%)" : "") + " = reaction " + str.tostring(s.rejReact) + " + dominance " + str.tostring(s.rejDom) + " + both " + str.tostring(s.rejBoth) + " · warm-up " + str.tostring(s.pivots - judged) + " → " + str.tostring(s.levels) + (s.isBsl ? " BSL" : " SSL") + " created"

// Cluster of one level: identity, reference vs current boundary, membership.
f_eqTxt(EqCluster c) =>
    string edge = c.ref == c.bound ? "boundary " + f_px(c.bound) + " (= reference)" : "boundary " + f_px(c.bound) + " · reference " + f_px(c.ref) + " · DIFFERS"
    (c.isHigh ? "EQH" : "EQL") + " id " + f_tid(c.id) + " · " + edge + " · ×" + str.tostring(c.members.size()) + " · last member " + f_mt(c.lastTime) + (na(c.qualBar) ? " · below min" : " · known " + f_mt(c.qualTime)) + (na(c.takenBar) ? " · ACTIVE" : " · TAKEN " + f_mt(c.takenTime) + " → " + f_clsName(c.cls))

// n-th newest liquidity level across both sides (by confirmation time).
f_liqNth(int n) =>
    array<Liq> all = bslS.live.copy()
    all.concat(bslS.hist)
    all.concat(sslS.live)
    all.concat(sslS.hist)
    Liq pick = na
    if n < all.size()
        array<int> ts = array.new<int>()
        for l in all
            ts.push(l.confirmTime)
        pick := all.get(ts.sort_indices(order.descending).get(n))
    pick

// Data Window: this bar's take on one side (0 none · 1 sweep · 2 break · 3 taken, bar open).
f_takeCode(int dir) =>
    int c = 0
    for e in barEv
        if e.dir == dir
            if e.kind == EV_LIQ_BREAK
                c := 2
            else if e.kind == EV_LIQ_SWEEP and c != 2
                c := 1
            else if e.kind == EV_LIQ_TAKEN and c == 0
                c := 3
    c

// Pine Logs. Debug mode: every event of a closed bar, one line in the "Last events"
// format with the full date (the pane shows up to 10,000 historical lines).
// Parity capture: only the last capN closed bars plus the warm-up the comparison
// needs (TR averages, pivot windows): CAPTURE (settings), then per bar one BAR line and
// that bar's events, then END. Bounded by capDone. Both read state only.
f_cap(float x) =>
    na(x) ? "na" : str.tostring(x, "#.########")

// Warm-up = the dependency graph of the compared values: an FVG verdict at t needs
// fvgLen true ranges ending at t − 2 (plus the close before them); a swing verdict at
// t = X + R needs, before X, the TR average (LIQ_TRA_LEN), the left window and the
// dominance window. Same formula as validation/models/types.py (lookback).
int  capWarm  = math.max(fvgLen + 2, math.max(LIQ_TRA_LEN, LIQ_L, LIQ_W) + LIQ_R)
int  capTotal = capN + capWarm
var int capDone = 0
bool capBar   = capOn and barstate.isconfirmed and bar_index > last_bar_index - capTotal and capDone < capTotal
if capBar
    if capDone == 0
        log.info("CAPTURE|sym=" + syminfo.tickerid + "|tf=" + timeframe.period + "|tick=" + str.tostring(syminfo.mintick) + "|tz=" + sesTz + "|confirmed=" + (confirmedOnly ? "1" : "0") + "|liq=" + (liqOn ? "1" : "0") + "|preset=" + f_presetName() + "|left=" + str.tostring(LIQ_L) + "|right=" + str.tostring(LIQ_R) + "|k=" + str.tostring(LIQ_K) + "|w=" + str.tostring(LIQ_W) + "|eqtol=" + str.tostring(eqTolTk) + "|eqmin=" + str.tostring(eqMinTch) + "|liqmem=" + str.tostring(liqMemory) + "|fvgticks=" + str.tostring(fvgMinTicks) + "|fvgtra=" + str.tostring(fvgMinTra) + "|fvgrng=" + str.tostring(fvgMinRng) + "|fvglen=" + str.tostring(fvgLen) + "|fvgmem=" + str.tostring(fvgMemory) + "|ses=" + s1Nm + "@" + s1Ss + "," + s2Nm + "@" + s2Ss + "," + s3Nm + "@" + s3Ss + "," + s4Nm + "@" + s4Ss + "|bars=" + str.tostring(capN) + "|warmup=" + str.tostring(capWarm))
    capDone += 1
    int fv = bullCand ? 2 : rawBull ? 1 : bearCand ? -2 : rawBear ? -1 : 0
    log.info("BAR|" + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ssZ", sesTz) + "|i=" + str.tostring(bar_index) + "|O=" + f_cap(open) + "|H=" + f_cap(high) + "|L=" + f_cap(low) + "|C=" + f_cap(close) + "|FV=" + str.tostring(fv) + "|FR=" + f_cap(reqGap) + "|SH=" + str.tostring(sigHi ? 2 : pivHi ? 1 : 0) + "|SL=" + str.tostring(sigLo ? 2 : pivLo ? 1 : 0) + "|RH=" + f_cap(pivHi ? reactHi : na) + "|RL=" + f_cap(pivLo ? reactLo : na) + "|RQ=" + f_cap(reactReq) + "|DH=" + f_cap(domHiRef) + "|DL=" + f_cap(domLoRef))
if barstate.isconfirmed and (capOn ? capBar : dbgOn)
    for e in barEv
        log.info(str.format_time(e.eventTime, "yyyy-MM-dd HH:mm", sesTz) + "  " + f_evText(e))
if capBar and capDone == capTotal
    log.info("END|bars=" + str.tostring(capDone))

if dbgOn and barstate.islast
    int bo = f_countOpen(bullFvgs)
    int ro = f_countOpen(bearFvgs)
    f_dbgRow(0, "Engine", (confirmedOnly ? "CONFIRMED" : "LIVE") + (barstate.isconfirmed ? " · bar closed" : " · bar open"))
    f_dbgRow(1, "Symbol", syminfo.tickerid + " · exch tz " + syminfo.timezone + " · " + syminfo.session)
    f_dbgRow(2, "FVG records ▲ · ▼ (open+closed)", str.tostring(bo) + "+" + str.tostring(bullFvgs.size() - bo) + " · " + str.tostring(ro) + "+" + str.tostring(bearFvgs.size() - ro) + "  (memory " + str.tostring(fvgMemory) + "/dir)")
    f_dbgRow(3, "FVG drawn ▲ · ▼ · faded", str.tostring(shownBull) + " · " + str.tostring(shownBear) + " · " + str.tostring(fadedFvg.size()))
    f_dbgRow(4, "Dropped by memory (open · closed)", str.tostring(dropOpen) + " · " + str.tostring(dropClosed))
    f_dbgRow(5, s1Nm, f_sesState(liveSes.get(0)))
    f_dbgRow(6, s2Nm, f_sesState(liveSes.get(1)))
    f_dbgRow(7, s3Nm, f_sesState(liveSes.get(2)))
    f_dbgRow(8, s4Nm, f_sesState(liveSes.get(3)))
    f_dbgRow(9, "PDH / PDL · PWH / PWL", f_lvlPx(K_PDH) + " / " + f_lvlPx(K_PDL) + " · " + f_lvlPx(K_PWH) + " / " + f_lvlPx(K_PWL))
    f_dbgRow(10, "Day · week start (ET)", (na(dStartT) ? "—" : str.format_time(dStartT, "EEE MM-dd HH:mm", "America/New_York")) + " · " + (na(wStartT) ? "—" : str.format_time(wStartT, "EEE MM-dd HH:mm", "America/New_York")))
    f_dbgRow(11, "D source check", f_check(pdN, pdBad, pdBadT))
    f_dbgRow(12, "W source check", f_check(pwN, pwBad, pwBadT))
    f_dbgRow(13, "Objects box · line · label", str.tostring(box.all.size()) + " · " + str.tostring(line.all.size()) + " · " + str.tostring(label.all.size()))
    Fvg q = f_nthNewest(dbgInspect)
    if na(q)
        f_dbgRow(14, "Inspect #" + str.tostring(dbgInspect), "no record in memory")
        for r = 15 to 20
            f_dbgRow(r, "", "")
    else
        f_dbgRow(14, "Inspect #" + str.tostring(dbgInspect), (q.isBull ? "BULL" : "BEAR") + " · id " + f_tid(q.id) + " · tf " + q.tf)
        f_dbgRow(15, "origin → confirm", "bar " + str.tostring(q.originBar) + " (" + f_mt(q.originTime) + ") → bar " + str.tostring(q.confirmBar) + " (" + f_mt(q.confirmTime) + ")")
        float g  = q.top - q.bottom
        bool  ok = g >= q.thrTick - EPS and g >= q.thrTra and g >= q.thrRng
        f_dbgRow(16, "zone prices", "top " + f_px(q.top) + " · CE " + f_px(q.mid) + " · bottom " + f_px(q.bottom))
        f_dbgRow(17, "size check @ birth", "gap " + f_px(g) + " pts = " + str.tostring(math.round(g / syminfo.mintick)) + " ticks (mintick " + f_num(syminfo.mintick) + ") · required max(tick " + f_num(q.thrTick) + ", TR " + f_num(q.thrTra) + ", rng " + f_num(q.thrRng) + ") = " + f_num(math.max(q.thrTick, q.thrTra, q.thrRng)) + " → " + (ok ? "PASS" : "INCONSISTENT"))
        f_dbgRow(18, "touch · CE · full · inval", f_mt(q.touchTime) + " · " + f_mt(q.ceTime) + " · " + f_mt(q.fullTime) + " · " + f_mt(q.invTime))
        f_dbgRow(19, "policy: " + f_ruleName(), q.activeAt(bar_index) ? "ACTIVE (not met)" : "MET " + f_mt(q.policyTime()))
        f_dbgRow(20, "record", (na(q.invBar) ? "OPEN" : "CLOSED (invalidated)") + " · fill " + str.tostring(math.round(q.fillPct() * 100)) + "% · age " + str.tostring(q.age()) + "b · drawn " + (na(q.zone) ? "no" : "yes"))
    // ── liquidity (Phase 2) ──
    f_dbgRow(21, "Liquidity engine", liqOn ? "ON · " + f_presetName() + " → left " + str.tostring(LIQ_L) + " · right " + str.tostring(LIQ_R) + " · reaction ≥ " + str.tostring(LIQ_K, "#.##") + " × TR(" + str.tostring(LIQ_TRA_LEN) + ") · dominance " + (LIQ_W > 0 ? str.tostring(LIQ_W) + " bars" : "off") + " · EQ tol " + str.tostring(eqTolTk) + " ticks · min " + str.tostring(eqMinTch) : "OFF")
    f_dbgRow(22, "Swing highs (loaded history)", f_selectivity(bslS))
    f_dbgRow(23, "Swing lows (loaded history)", f_selectivity(sslS))
    f_dbgRow(24, "BSL", f_liqSideState(bslS))
    f_dbgRow(25, "SSL", f_liqSideState(sslS))
    f_dbgRow(26, "EQH · EQL", f_eqState(bslS) + "  ·  " + f_eqState(sslS) + " · dropped " + str.tostring(bslS.dropEq + sslS.dropEq))
    f_dbgRow(27, "Liquidity drawn", "BSL " + str.tostring(liqCnt.get(0)) + " · SSL " + str.tostring(liqCnt.get(1)) + " · EQH " + str.tostring(liqCnt.get(2)) + " · EQL " + str.tostring(liqCnt.get(3)) + " · taken " + str.tostring(liqCnt.get(4)) + "+" + str.tostring(liqCnt.get(5)) + " · on a reference line " + str.tostring(liqCnt.get(6)))
    Liq w = f_liqNth(dbgLiqIns)
    if na(w)
        f_dbgRow(28, "Liq inspect #" + str.tostring(dbgLiqIns), "no level in memory")
        for r = 29 to 32
            f_dbgRow(r, "", "")
    else
        f_dbgRow(28, "Liq inspect #" + str.tostring(dbgLiqIns), (w.isBsl ? "BSL" : "SSL") + " · id " + f_tid(w.id) + " · price " + f_px(w.price))
        f_dbgRow(29, "swing → known", "bar " + str.tostring(w.originBar) + " (" + f_mt(w.originTime) + ") → bar " + str.tostring(w.confirmBar) + " (" + f_mt(w.confirmTime) + ") · window left " + str.tostring(w.pivL) + " · right " + str.tostring(w.pivR))
        f_dbgRow(30, "significance @ birth", "reaction " + f_num(w.react) + " pts = " + f_num(w.react / w.tra) + " × TR (" + f_num(w.tra) + ") · required " + f_num(w.reactReq) + " → " + (w.react >= w.reactReq ? "PASS" : "INCONSISTENT"))
        string st = na(w.takenBar) ? "ACTIVE · exact touches " + str.tostring(w.touches) : "TAKEN " + f_mt(w.takenTime) + " · reached " + f_px(w.takeExt) + " (+" + str.tostring(math.round(math.abs(w.takeExt - w.price) / syminfo.mintick)) + " ticks)" + (w.takeGap ? " · opened beyond" : "") + " · close " + f_px(w.takeClose) + " → " + f_clsName(w.cls) + " · touches before " + str.tostring(w.touches)
        f_dbgRow(31, "status (this swing)", st + (w.eqOpen ? "" : " · closed"))
        f_dbgRow(32, "EQ cluster (pool)", na(w.eq) ? "none" : f_eqTxt(w.eq))
    f_dbgRow(33, "Last events", f_lastEvents(6))
    // Closed bars only: in Confirmed mode an open last bar is not processed yet.
    f_dbgRow(34, "Loaded history (closed bars)", f_tid(dbgFirstT) + " → " + f_tid(barstate.isconfirmed ? time : time[1]) + " · " + str.tostring(bar_index + (barstate.isconfirmed ? 1 : 0)) + " bars · tz " + sesTz)

// Normal-mode warnings: non-standard candles, and objects nearing the hard limit
// (TradingView would otherwise delete the oldest drawings silently).
if barstate.islast
    int peak = math.max(box.all.size(), line.all.size(), label.all.size())
    table.cell(warnTbl, 0, 0, chart.is_standard ? "" : "IST · non-standard candles: FVGs and levels use synthetic prices", text_color = #FF9800, text_size = size.small)
    table.cell(warnTbl, 0, 1, peak > OBJ_WARN ? "IST · " + str.tostring(peak) + " drawing objects of one type (limit 500): lower display caps" : "", text_color = #FF9800, text_size = size.small)

// Data Window only, per bar (put the cursor on candle 3): the exact numbers the
// L4 filter used, so any accept/reject decision can be audited.
plot(dbgOn ? (bullCand ? 2 : rawBull ? 1 : bearCand ? -2 : rawBear ? -1 : 0) : na, "dbg · candle 3 verdict (±2 PASS · ±1 REJECT · 0 no gap)", color = #787B86, display = display.data_window, editable = false)
plot(dbgOn ? rawGap : na, "dbg · raw gap (points)", color = #787B86, display = display.data_window, editable = false)
plot(dbgOn ? math.round(rawGap / syminfo.mintick) : na, "dbg · raw gap (ticks)", color = #787B86, display = display.data_window, editable = false)
plot(dbgOn ? syminfo.mintick : na, "dbg · syminfo.mintick", color = #787B86, display = display.data_window, editable = false)
plot(dbgOn ? tickReq : na, "dbg · required · ticks (points)", color = #787B86, display = display.data_window, editable = false)
plot(dbgOn ? traReq : na, "dbg · required · TR average (points)", color = #787B86, display = display.data_window, editable = false)
plot(dbgOn ? rngReq : na, "dbg · required · avg range (points)", color = #787B86, display = display.data_window, editable = false)
plot(dbgOn ? reqGap : na, "dbg · required gap = max (points)", color = #787B86, display = display.data_window, editable = false)
plot(dbgOn ? refTra : na, "dbg · TR average at candle 1 (t-2)", color = #787B86, display = display.data_window, editable = false)
plot(dbgOn ? refRng : na, "dbg · avg range at candle 1 (t-2)", color = #787B86, display = display.data_window, editable = false)
plot(dbgOn ? bullFvgs.size() + bearFvgs.size() : na, "dbg · FVG records (logical)", color = #787B86, display = display.data_window, editable = false)
// Liquidity (put the cursor on the confirmation bar = swing bar + right).
bool dbgLiq = dbgOn and liqOn
plot(dbgLiq ? (sigHi ? 2 : pivHi ? 1 : 0) : na, "dbg · LIQ swing high judged here (2 → BSL · 1 rejected · 0 none)", color = #787B86, display = display.data_window, editable = false)
plot(dbgLiq ? (sigLo ? 2 : pivLo ? 1 : 0) : na, "dbg · LIQ swing low judged here (2 → SSL · 1 rejected · 0 none)", color = #787B86, display = display.data_window, editable = false)
plot(dbgLiq and pivHi ? reactHi : na, "dbg · LIQ reaction of that swing high (points)", color = #787B86, display = display.data_window, editable = false)
plot(dbgLiq and pivLo ? reactLo : na, "dbg · LIQ reaction of that swing low (points)", color = #787B86, display = display.data_window, editable = false)
plot(dbgLiq ? reactReq : na, "dbg · LIQ required reaction = k × TR average at swing bar (points)", color = #787B86, display = display.data_window, editable = false)
plot(dbgLiq ? domHiRef : na, "dbg · LIQ dominance: highest high of the W bars before the swing (points)", color = #787B86, display = display.data_window, editable = false)
plot(dbgLiq ? domLoRef : na, "dbg · LIQ dominance: lowest low of the W bars before the swing (points)", color = #787B86, display = display.data_window, editable = false)
plot(dbgLiq ? f_takeCode(1) : na, "dbg · LIQ BSL take on this bar (0 · 1 sweep · 2 break · 3 taken, bar open)", color = #787B86, display = display.data_window, editable = false)
plot(dbgLiq ? f_takeCode(-1) : na, "dbg · LIQ SSL take on this bar (0 · 1 sweep · 2 break · 3 taken, bar open)", color = #787B86, display = display.data_window, editable = false)
