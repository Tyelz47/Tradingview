s3Ss      = input.session("0930-1200", "", inline = "s3", group = G_SES, display = display.none)
s3Cl      = input.color(#C9A86A, "", inline = "s3", group = G_SES, display = display.none)
s4Show    = input.bool(true, "", inline = "s4", group = G_SES, display = display.none)
s4Nm      = input.string("NY PM", "", inline = "s4", group = G_SES, display = display.none)
s4Ss      = input.session("1330-1600", "", inline = "s4", group = G_SES, display = display.none)
s4Cl      = input.color(#C98A6A, "", inline = "s4", group = G_SES, display = display.none)
sesHL     = input.bool(true, "High / low lines", group = G_SES, display = display.none)
sesDev    = input.bool(true, "Show developing range", group = G_SES, display = display.none)
sesMid    = input.bool(false, "Midpoint", inline = "sx", group = G_SES, display = display.none)
