doShow    = input.bool(false, "Day open (TradingView day)", inline = "do", group = G_LVL, display = display.none)
doCol     = input.color(#787B86, "", inline = "do", group = G_LVL, display = display.none)
moShow    = input.bool(false, "Midnight open", inline = "mo", group = G_LVL, display = display.none)
moCol     = input.color(#787B86, "", inline = "mo", group = G_LVL, display = display.none)
lvlLabels = input.bool(true, "Labels", group = G_LVL, display = display.none)
lvlAnchor = input.bool(true, "Start line at the extreme's bar", tooltip = TT_ANCH, group = G_LVL, display = display.none)
