alTiming  = input.enum(AlertTiming.barClose, "Timing", tooltip = TT_ALT, group = G_ALR, display = display.none)
alBullNew = input.bool(true, "FVG created · bull", inline = "a1", group = G_ALR, display = display.none)
alBearNew = input.bool(true, "bear", inline = "a1", group = G_ALR, display = display.none)
alTouch   = input.bool(false, "First touch", inline = "a2", group = G_ALR, display = display.none)
